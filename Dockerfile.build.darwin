FROM ubuntu:22.04

ARG GITHUB_REF_NAME
ENV GITHUB_REF_NAME=$GITHUB_REF_NAME
ENV DEBIAN_FRONTEND=noninteractive

# Зависимости для osxcross + сборки
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang \
    cmake \
    git \
    libssl-dev \
    libxml2-dev \
    lzma-dev \
    make \
    patch \
    python3 \
    uuid-dev \
    xz-utils \
    zip \
    zlib1g-dev \
    wget \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Собираем osxcross с macOS 12.3 SDK
RUN git clone --depth 1 https://github.com/tpoechtrager/osxcross /opt/osxcross
RUN wget -q https://github.com/joseluisq/macosx-sdks/releases/download/12.3/MacOSX12.3.sdk.tar.xz \
    -O /opt/osxcross/tarballs/MacOSX12.3.sdk.tar.xz
RUN cd /opt/osxcross && UNATTENDED=1 ./build.sh

ENV PATH="/opt/osxcross/target/bin:$PATH"
ENV MACOSX_DEPLOYMENT_TARGET=12.0
ENV OSXCROSS_NO_INCLUDE_PATH_WARNINGS=1

# Устанавливаем Go 1.24.3
ENV GOLANG_VERSION=1.24.3
RUN wget -q https://go.dev/dl/go${GOLANG_VERSION}.linux-amd64.tar.gz -O /tmp/go.tar.gz && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm /tmp/go.tar.gz

ENV GOPATH=/go
ENV PATH="/usr/local/go/bin:${GOPATH}/bin:$PATH"

RUN mkdir -p "$GOPATH/src" "$GOPATH/bin" && chmod -R 777 "$GOPATH"
WORKDIR $GOPATH

COPY . /usr/src/app
RUN cd /usr/src/app && GITHUB_REF_NAME=$GITHUB_REF_NAME make build-darwin
